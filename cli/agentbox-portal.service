# Self-service portal: memories and connected accounts.
#
# Runs as the OPERATOR's systemd user instance, never as the agentbox user.
# Same property as the approval loop, and for a stronger reason: this process
# holds MEMORY_REVIEW_TOKEN, which approves any memory proposal. If the
# assistant could start, stop, signal or share a uid with it, the review gate
# would be a formality — self-approval is exactly what that gate prevents.
#
# Install:
#   cp cli/agentbox-portal.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now agentbox-portal
#   sudo loginctl enable-linger "$USER"
#
# Then sign in at http://127.0.0.1:8771 on this box, or at the LAN address
# from a phone. See docs/runbook.md — the LAN address works for everything
# except the Google consent redirect, which Google will only accept on
# loopback or a real https domain.

[Unit]
Description=Agentbox self-service portal
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# Credentials, read from the operator's env dir rather than duplicated here:
# MEMORY_BRIDGE_TOKEN and MEMORY_REVIEW_TOKEN from the first, GOOGLE_CLIENT_ID
# from the second.
#
# These files hold `op://` references, not literal secrets — the same files
# `agentbox deploy` feeds to `op run`. systemd's EnvironmentFile does NOT
# resolve them: it would set MEMORY_BRIDGE_TOKEN to the literal string
# "op://Agentbox/..." and the portal would present that as a bearer token,
# so the memory bridge answered 401 and the page said "service not
# responding", while GOOGLE_CLIENT_ID was the literal op:// string and Google
# returned "invalid_client". Both symptoms, one cause.
#
# So the portal is launched under `op run --env-file` (see ExecStart), which
# resolves the references before the process starts, exactly as deploy does.
# The service-account token that authorises that resolution lives in
# 1password.env, sourced below; a leading dash means a box without 1Password
# still starts (with unresolved refs, which then fail loudly rather than
# silently — that is the bug this replaced).
EnvironmentFile=-%h/.config/agent-control-plane/1password.env

# Broad Drive read, opted into by the operator on 2026-08-13. Without this the
# assistant sees only files it created, which made "find that lease in my
# Drive" unanswerable against a full Drive. Read-only: it still cannot write
# outside its own folder, delete, or share.
Environment=GOOGLE_ENABLE_DRIVE_READ_ALL=1

# Who is an admin. Everyone else is a member: their own memories and their own
# connectors, no operations. Empty would mean nobody is an admin, which is the
# right direction for a misread value to fail in.
Environment=AGENTBOX_ADMINS=alex

# Sign-in addresses. An address here is not a credential — it only decides
# where a magic link is sent, and the link is useless in another browser.
Environment=AGENTBOX_IDENTITY_EMAILS=alex:alex@example.com

# Delivery for sign-in links. Without a host here, links are minted and never
# sent — and the sign-in page cannot say so, because answering differently for
# a registered address would reveal who lives here. `agentbox doctor` warns
# instead.
#
# Gmail needs an app password (myaccount.google.com/apppasswords), not the
# account password, and that needs 2FA switched on. Put it in the env file
# below rather than here:
#   AGENTBOX_SMTP_HOST=smtp.gmail.com
#   AGENTBOX_SMTP_USER=you@gmail.com
#   AGENTBOX_SMTP_PASSWORD=<app password>
EnvironmentFile=-%h/.config/agent-control-plane/portal-smtp.env

# The address links point at, and the base of the Google redirect URI.
# Loopback by default because Google refuses .local and bare LAN hostnames
# outright; `agentbox validate` fails if this is set to something the console
# will not accept.
Environment=AGENTBOX_PORTAL_URL=http://127.0.0.1:8771

# Bound to all interfaces so a phone on the LAN can reach it. The magic-link
# flow is what protects it, not the network boundary.
#
# Launched under `op run` so the op:// references in the two --env-file
# arguments are resolved into real values for this process only — never
# written to disk, never in the unit. This mirrors `agentbox deploy`, which
# wraps docker compose the same way. The portal's own plain-value settings
# (admins, addresses, SMTP, URL) stay as Environment=/EnvironmentFile= above
# and are inherited through op run untouched; op run only overlays the two
# files named here.
ExecStart=/usr/bin/op run \
    --env-file=%h/.config/agent-control-plane/memory-bridge.env \
    --env-file=%h/.config/agent-control-plane/google-workspace-bridge.env \
    -- %h/oss/agentbox/cli/agentbox-portal serve --host 0.0.0.0 --port 8771
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Links, sessions, and pending connector requests.
ReadWritePaths=%h/.local/state/agentbox

[Install]
WantedBy=default.target
