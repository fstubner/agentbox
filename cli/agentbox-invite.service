# The collecting half of onboarding, the form somebody fills in on their phone.
#
# Install:
#   cp cli/agentbox-invite.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now agentbox-invite
#
# This is the least privileged process on this box. cli/agentbox-invite
# explains why. It has no docker socket, no 1Password token and no bridge
# tokens, and it cannot create an identity. It can only write one spool file,
# because it is a LAN-reachable page and people outside the household are sent
# links to it.
#
# It runs as a unit because the link is delivered by email or DM. If it were
# started by hand, an invitation opened while nobody has a terminal open would
# reach a closed port, and the recipient would see a broken page.
#
# Restart=always for the same reason. The person holding the link cannot ask
# anyone to restart anything.
#
# --unattended is required here. Run by hand, `serve` exits 1 with nothing
# outstanding, because that almost always means `create` was forgotten. Under
# Restart=always that would be a crash loop every five seconds. The flag marks
# an empty spool as the normal state, and cli/agentbox-invite records why that
# differs from the hand-run case.

# AGENTBOX_INVITE_ORIGIN is not set here, so the form skips the Google step
# instead of offering one that fails.
#
# The origin is both where Google sends the person back and where they opened
# the form. Those differ when somebody uses a phone. Loopback resolves to their
# handset, and Google will not accept the LAN name instead. Skipping the step
# is the safer failure. They finish onboarding, get their account, and connect
# Google afterwards from the portal under "Your accounts", where the redirect
# is loopback and consent happens at this machine.
#
# Set it only if invitees will fill the form in on the box itself, in which
# case http://127.0.0.1:8770 works and the Google step happens inline.

[Unit]
Description=Agentbox onboarding form
After=network-online.target

[Service]
ExecStart=%h/oss/agentbox/cli/agentbox-invite serve --unattended
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
