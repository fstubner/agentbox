#!/usr/bin/env python3
"""The Discord approval loop.

When a tool is refused for lack of approval, agentbox-mcp records it. This
process posts the request to Discord, waits for the operator to reply, and
writes the grant.

## Why a separate process

The assistant is in the same Discord. If it could ask for its own approval, an
instruction in an email could make it ask, and a person is likely to approve a
request that looks reasonable. So approval never passes through the model.
This process

- runs as the operator, not as the agentbox user,
- reads requests from a place the assistant can only add to,
- accepts replies only from configured Discord user ids, and ignores every
  message written by a bot, including the assistant's own,
- writes the grant to a directory the assistant's containers mount read-only.

MCP elicitation would put this in the conversation, but it needs a streaming
transport this server does not have, and the 2026-07-28 revision replaces it
with MRTR.

Standard library only. Discord's REST API is enough to post and poll.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path

POLL_SECONDS = int(os.environ.get("AGENTBOX_APPROVAL_POLL_SECONDS", "5"))
DEFAULT_TTL = os.environ.get("AGENTBOX_APPROVAL_TTL", "15m")

STATE = Path(os.environ.get("AGENTBOX_POLICY_STATE_DIR",
                            str(Path("~/.local/state/agentbox/policy-state").expanduser())))
PENDING = STATE / "pending"
CURSOR = STATE / "approvals-cursor.json"


def pending_requests() -> list[dict]:
    if not PENDING.is_dir():
        return []
    out = []
    for entry in sorted(PENDING.glob("*.json")):
        try:
            record = json.loads(entry.read_text(encoding="utf-8"))
            record["_path"] = str(entry)
            out.append(record)
        except (OSError, ValueError):
            continue
    return out


def load_cursor() -> dict:
    try:
        return json.loads(CURSOR.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def save_cursor(state: dict) -> None:
    try:
        CURSOR.parent.mkdir(parents=True, exist_ok=True)
        CURSOR.write_text(json.dumps(state), encoding="utf-8")
    except OSError:
        pass


def grant(tool: str, ttl: str, repeatable: bool = False) -> bool:
    args = [str(REPO / "cli" / "agentbox"), "grant", tool, "--ttl", ttl]
    if repeatable:
        args.append("--repeatable")
    result = subprocess.run(args, capture_output=True, text=True, timeout=30)
    print(result.stdout.strip() or result.stderr.strip(), flush=True)
    return result.returncode == 0


def clear_pending(tool: str) -> None:
    (PENDING / f"{tool}.json").unlink(missing_ok=True)


OUTCOME_DIR = Path(os.environ.get(
    "AGENTBOX_LOG_DIR", str(Path("~/.local/state/agentbox/logs").expanduser())))

# The same settings the portal writes, from a module beside this script. It
# runs as the operator, the only user who can read the file.
sys.path.insert(0, str(Path(__file__).resolve().parent))
from agentbox_approvals_discord import (  # noqa: E402, F401
    API,
    CHAT_LINKS,
    LINK_CURSOR,
    PORTAL_DIR,
    REPO,
    SETTINGS,
    _op_operators,
    approval_channel,
    approval_operators,
    discord,
    dm_channel,
    log,
    op_read,
    short_id,
)
from agentbox_approvals_links import (  # noqa: E402, F401
    complete_pairings,
    deliver_pending_links,
    link_cursor,
    remember_link_request,
    send_link_on_request,
)
from agentbox_approvals_memory import (  # noqa: E402, F401
    MEMORY_BRIDGE_URL,
    announce_proposals,
    handle_memory_reply,
    identity_discord_map,
    memory_call,
    resolve_memory,
)


def record_denial(tool: str, user_id: str) -> None:
    """Record a refusal in the outcome journal.

    Approvals are recorded by `agentbox grant`. Refusals are recorded here, so
    the journal holds both outcomes.
    """
    try:
        OUTCOME_DIR.mkdir(parents=True, exist_ok=True)
        with (OUTCOME_DIR / "operator-outcomes.jsonl").open("a", encoding="utf-8") as handle:
            handle.write(json.dumps({"ts": int(time.time()), "actor": "operator",
                                     "action": "deny", "subject": tool,
                                     "detail": f"discord:{user_id}"}) + "\n")
    except OSError as exc:
        log(f"could not record denial of {tool}: {exc}")


def main() -> int:
    token = os.environ.get("DISCORD_BOT_TOKEN") or op_read("op://Agentbox/discord/bot_token")
    # Read once here to fail loudly at startup, and again each pass so a
    # change made on the Operations page takes effect without a service
    # restart.
    channel = approval_channel()
    if not channel:
        sys.exit("no approval channel configured; set one on the portal's "
                 "Operations page (or AGENTBOX_APPROVAL_CHANNEL_ID)")
    operators = approval_operators()
    if not operators:
        sys.exit("no operator user ids configured; refusing to accept approvals "
                 "from anyone. Set them on the portal's Operations page.")

    print(f"agentbox-approvals: channel {channel}, {len(operators)} operator id(s), "
          f"polling every {POLL_SECONDS}s", flush=True)
    state = load_cursor()

    while True:
        # Read the current list each time and use it as it is, so removing an
        # id on the portal takes effect at once. An empty list means nobody can
        # approve, so a misconfiguration fails closed.
        channel = approval_channel()
        operators = approval_operators()
        complete_pairings(token)
        send_link_on_request(token)
        deliver_pending_links(token)
        announce_proposals(channel, token, state)
        for request in pending_requests():
            tool = request.get("tool", "")
            if state.get("announced", {}).get(tool):
                continue
            capability = request.get("capability") or "no mapped capability"
            posted = discord("POST", f"/channels/{channel}/messages", token, {
                "content": (f"**Approval needed**\n"
                            f"`{tool}`: capability `{capability}`\n"
                            f"Reply `approve {tool}` to allow it once "
                            f"({DEFAULT_TTL}), or `deny {tool}` to clear it."),
            })
            if posted:
                state.setdefault("announced", {})[tool] = int(time.time())
                save_cursor(state)
                log(f"asked about {tool} ({capability})")
            else:
                # Log the failure, so it is not mistaken for a broken loop.
                log(f"could not post approval request for {tool}")

        params = f"?limit=25&after={state['last_id']}" if state.get("last_id") else "?limit=10"
        messages = discord("GET", f"/channels/{channel}/messages{params}", token) or []
        for message in reversed(messages):
            state["last_id"] = message.get("id", state.get("last_id"))
            author = message.get("author") or {}
            # Bots are ignored outright, so the assistant cannot approve itself
            # even if an injected instruction makes it type the words.
            if author.get("bot"):
                continue
            if str(author.get("id")) not in operators:
                continue
            words = str(message.get("content", "")).strip().split()
            if not words:
                continue
            # Memory review shares this loop and its protections. Bot messages
            # are already skipped above, so the assistant cannot approve its own
            # memory by typing.
            if handle_memory_reply(words[0].lower(),
                                   words[1].strip("`") if len(words) > 1 else "",
                                   channel, token, state,
                                   [w.strip("`") for w in words[2:]]):
                save_cursor(state)
                continue
            if len(words) < 2 or words[0].lower() not in ("approve", "deny"):
                continue
            verb, tool = words[0].lower(), words[1].strip("`")
            if not (PENDING / f"{tool}.json").exists():
                discord("POST", f"/channels/{channel}/messages", token,
                        {"content": f"nothing pending for `{tool}`"})
                continue
            if verb == "approve":
                ok = grant(tool, DEFAULT_TTL)
                discord("POST", f"/channels/{channel}/messages", token, {
                    "content": (f"approved `{tool}` for {DEFAULT_TTL}. Ask again and it "
                                f"will go through" if ok else f"could not grant `{tool}`")})
            else:
                record_denial(tool, str(author.get("id")))
                discord("POST", f"/channels/{channel}/messages", token,
                        {"content": f"denied `{tool}`"})
            log(f"{verb} {tool} from discord user {author.get('id')}")
            clear_pending(tool)
            state.get("announced", {}).pop(tool, None)
        save_cursor(state)
        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("stopped", flush=True)
