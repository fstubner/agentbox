#!/usr/bin/env python3
"""agentbox: the operator CLI.

This file only parses arguments and dispatches. Each command lives in a
sibling module, such as `agentbox_validate.py` for `validate` and
`agentbox_doctor.py` for `doctor` and `status`. Run `agentbox --help` for the
full list.
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import agentbox_backup  # noqa: E402
import agentbox_identity  # noqa: E402
import agentbox_keepalive  # noqa: E402
import agentbox_memory  # noqa: E402
import agentbox_rules  # noqa: E402
import agentbox_scaffold  # noqa: E402
import agentbox_setup  # noqa: E402
from agentbox_accounts import (  # noqa: E402
    connectors_sync,
    identity_disconnect,
    identity_reconnect,
)
from agentbox_common import (  # noqa: E402
    FAIL,
    REPO,
    report,
)
from agentbox_deploy import (  # noqa: E402
    deploy,
    update,
)
from agentbox_doctor import (  # noqa: E402
    doctor,
    status,
)
from agentbox_invites import (  # noqa: E402
    invite_complete,
    invite_drain,
)
from agentbox_policy import (  # noqa: E402
    approvals_clear,
    approvals_list,
    grant,
    grants_list,
    grants_revoke,
    policy_check,
    policy_drift,
    policy_sync,
)
from agentbox_proposals import (  # noqa: E402
    proposals_list,
    proposals_merge,
    proposals_show,
)
from agentbox_smoke import (  # noqa: E402
    scenarios,
    smoke,
)
from agentbox_validate import (  # noqa: E402
    validate,
)


def main() -> None:
    parser = argparse.ArgumentParser(prog="agentbox")
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("validate")
    sub.add_parser("setup", help="prepare this machine (directories, permissions, sandboxing, secret templates)")
    dep = sub.add_parser("deploy")
    dep.add_argument("service")
    dep.add_argument("--dry-run", action="store_true")
    sub.add_parser("doctor")
    sub.add_parser("smoke", help="drive real workflows end to end against the running system")
    sub.add_parser("scenarios", help="count which everyday requests the assistant can answer")
    inv = sub.add_parser("invite", help="finish onboarding somebody who used an invite link")
    inv_sub = inv.add_subparsers(dest="invite_cmd", required=True)
    invc = inv_sub.add_parser("complete")
    invc.add_argument("token_id")
    inv_sub.add_parser(
        "drain", help="complete the invites an admin approved from the portal")
    idn = sub.add_parser("identity", help="manage who the assistant can act for")
    idn_sub = idn.add_subparsers(dest="identity_cmd", required=True)
    idn_sub.add_parser("list")
    ida = idn_sub.add_parser("add")
    ida.add_argument("name")
    idr = idn_sub.add_parser("remove")
    idr.add_argument("name")
    idrc = idn_sub.add_parser("reconnect",
                              help="finish a reconnect started in the portal")
    idrc.add_argument("name")
    idd = idn_sub.add_parser("disconnect",
                             help="revoke and remove a Google connection")
    idd.add_argument("name")
    rul = sub.add_parser("rules", help="standing rules the assistant proposed")
    rul_sub = rul.add_subparsers(dest="rules_cmd", required=True)
    rul_sub.add_parser("list")
    for verb in ("approve", "reject", "remove"):
        pr_ = rul_sub.add_parser(verb)
        pr_.add_argument("name")
    con = sub.add_parser("connectors",
                         help="complete connector requests raised in the portal")
    con_sub = con.add_subparsers(dest="connectors_cmd", required=True)
    cs = con_sub.add_parser("sync")
    cs.add_argument("--quiet", action="store_true",
                    help="say nothing when there is nothing to do")
    ka = sub.add_parser("keepalive",
                        help="restore the model stack if an evaluation left it down")
    ka.add_argument("--quiet", action="store_true",
                    help="say nothing unless something was restored")
    pr = sub.add_parser("proposals", help="review code changes the assistant has proposed")
    pr_sub = pr.add_subparsers(dest="proposals_cmd", required=True)
    pr_sub.add_parser("list")
    prs = pr_sub.add_parser("show")
    prs.add_argument("name")
    prm = pr_sub.add_parser("merge", help="check the proposal out on a review/ branch")
    prm.add_argument("name")
    sub.add_parser("status")
    pol = sub.add_parser("policy")
    pol_sub = pol.add_subparsers(dest="pol_cmd", required=True)
    check = pol_sub.add_parser("check")
    check.add_argument("action")
    pol_sub.add_parser("sync", help="copy the committed policy onto the bridge mount")
    pol_sub.add_parser("drift", help="is the enforced policy the committed one")
    up = sub.add_parser("update",
                        help="pull a newer third-party image and redeploy")
    up.add_argument("service")
    rc = sub.add_parser("restore-check",
                        help="rehearse a restore from the newest backup")
    rc.add_argument("--archive", default="", help="a specific archive name")
    bk = sub.add_parser("backup", help="archive the task and memory stores")
    bk.add_argument("--keep", type=int, default=14, help="archives to retain (default 14)")
    bk_sub = bk.add_subparsers(dest="backup_cmd")
    bk_sub.add_parser("list")
    sc = sub.add_parser("scaffold", help="generate a new bridge for review (never deploys)")
    sc.add_argument("name", help="service name, e.g. todoist -> todoist-bridge")
    sc.add_argument("--port", type=int, help="host port; auto-picked from 3480-3499 if omitted")
    sc.add_argument("--upstream-env", help="upstream credential env var name")
    gr = sub.add_parser("grant", help="authorise an approval_required tool for a period")
    gr.add_argument("tool")
    gr.add_argument("--ttl", default="15m", help="e.g. 30s, 15m, 2h (default 15m)")
    gr.add_argument("--repeatable", action="store_true",
                    help="allow repeated use until expiry instead of single-use")
    gr.add_argument("--for", dest="identity", default="",
                    help="scope the grant to one identity (e.g. alex); "
                         "unscoped grants cover anyone")
    ap = sub.add_parser("approvals", help="what the assistant is waiting on")
    ap_sub = ap.add_subparsers(dest="approvals_cmd", required=True)
    ap_sub.add_parser("list")
    apc = ap_sub.add_parser("clear")
    apc.add_argument("tool", nargs="?")
    grs = sub.add_parser("grants", help="list or revoke runtime grants")
    grs_sub = grs.add_subparsers(dest="grants_cmd", required=True)
    grs_sub.add_parser("list")
    rv = grs_sub.add_parser("revoke")
    rv.add_argument("tool", nargs="?")
    mem = sub.add_parser("memory", help="review memory proposals (operator only)")
    mem_sub = mem.add_subparsers(dest="mem_cmd", required=True)
    meml = mem_sub.add_parser("list")
    meml.add_argument("--identity", default="",
                      help="show only this identity's scope")
    approve = mem_sub.add_parser("approve")
    approve.add_argument("proposal_id")
    reject = mem_sub.add_parser("reject")
    reject.add_argument("proposal_id")
    reject.add_argument("--reason", default="")
    mem_sub.add_parser("show", help="list stored memories")
    forget = mem_sub.add_parser("forget", help="remove a stored memory")
    forget.add_argument("memory_id")
    forget.add_argument("--reason", default="")
    add = mem_sub.add_parser("add", help="state a fact directly, no review step")
    add.add_argument("statement")
    add.add_argument("--scope", default="",
                     help="'household' (default) or an identity name")
    add.add_argument("--type", dest="memory_type", default="")
    add.add_argument("--supersedes", default="",
                     help="id of the memory this replaces")
    hist = mem_sub.add_parser("history", help="how a fact changed over time")
    hist.add_argument("memory_id")

    fb = sub.add_parser("feedback",
                        help="things to fix in a skill rather than remember")
    fb_sub = fb.add_subparsers(dest="fb_cmd", required=True)
    fbl = fb_sub.add_parser("list")
    fbl.add_argument("--status", default="open",
                     choices=["open", "folded", "dismissed", "all"])
    fold = fb_sub.add_parser("fold", help="you changed something; retire this")
    fold.add_argument("feedback_id")
    fold.add_argument("--note", default="", help="what you changed")
    dismiss = fb_sub.add_parser("dismiss")
    dismiss.add_argument("feedback_id")
    dismiss.add_argument("--note", default="")
    args = parser.parse_args()

    if args.cmd == "validate":
        sys.exit(validate())
    if args.cmd == "deploy":
        sys.exit(deploy(args.service, args.dry_run))
    if args.cmd == "doctor":
        sys.exit(doctor())
    if args.cmd == "scenarios":
        sys.exit(scenarios())
    if args.cmd == "smoke":
        sys.exit(smoke())
    if args.cmd == "invite":
        if args.invite_cmd == "drain":
            sys.exit(invite_drain())
        sys.exit(invite_complete(args.token_id))
    if args.cmd == "identity":
        if args.identity_cmd == "list":
            sys.exit(agentbox_identity.identity_list())
        if args.identity_cmd == "add":
            sys.exit(agentbox_identity.identity_add(args.name))
        if args.identity_cmd == "reconnect":
            sys.exit(identity_reconnect(args.name))
        if args.identity_cmd == "disconnect":
            sys.exit(identity_disconnect(args.name))
        # `remove` has its own branch with no fallthrough. It deletes an
        # identity. As a default, any subcommand added later without a branch
        # here would delete an identity instead of erroring.
        if args.identity_cmd == "remove":
            sys.exit(agentbox_identity.identity_remove(args.name))
        report(FAIL, f"unknown identity subcommand: {args.identity_cmd}")
        sys.exit(2)
    if args.cmd == "rules":
        if args.rules_cmd == "list":
            sys.exit(agentbox_rules.rules_list())
        if args.rules_cmd == "approve":
            sys.exit(agentbox_rules.rules_decide(args.name, True))
        if args.rules_cmd == "reject":
            sys.exit(agentbox_rules.rules_decide(args.name, False))
        sys.exit(agentbox_rules.rules_remove(args.name))
    if args.cmd == "connectors":
        sys.exit(connectors_sync(args.quiet))
    if args.cmd == "setup":
        sys.exit(agentbox_setup.setup(REPO, report=report))
    if args.cmd == "keepalive":
        sys.exit(agentbox_keepalive.main(["--quiet"] if args.quiet else []))
    if args.cmd == "proposals":
        if args.proposals_cmd == "list":
            sys.exit(proposals_list())
        if args.proposals_cmd == "show":
            sys.exit(proposals_show(args.name))
        sys.exit(proposals_merge(args.name))
    if args.cmd == "status":
        sys.exit(status())
    if args.cmd == "policy" and args.pol_cmd == "sync":
        sys.exit(policy_sync())
    if args.cmd == "policy" and args.pol_cmd == "drift":
        sys.exit(policy_drift())
    if args.cmd == "policy" and args.pol_cmd == "check":
        sys.exit(policy_check(args.action))
    if args.cmd == "update":
        sys.exit(update(args.service))
    if args.cmd == "restore-check":
        sys.exit(agentbox_backup.restore_check(args.archive, report=report))
    if args.cmd == "backup":
        if getattr(args, "backup_cmd", None) == "list":
            sys.exit(agentbox_backup.backup_list())
        sys.exit(agentbox_backup.backup(args.keep, report=report))
    if args.cmd == "scaffold":
        sys.exit(agentbox_scaffold.scaffold(args.name, args.port, args.upstream_env))
    if args.cmd == "grant":
        sys.exit(grant(args.tool, args.ttl, args.repeatable, args.identity))
    if args.cmd == "approvals":
        sys.exit(approvals_list() if args.approvals_cmd == "list"
                 else approvals_clear(args.tool))
    if args.cmd == "grants":
        sys.exit(grants_list() if args.grants_cmd == "list" else grants_revoke(args.tool))
    if args.cmd == "memory":
        if args.mem_cmd == "list":
            sys.exit(agentbox_memory.memory_list(args.identity))
        if args.mem_cmd == "show":
            sys.exit(agentbox_memory.memory_show())
        if args.mem_cmd == "forget":
            sys.exit(agentbox_memory.memory_forget(args.memory_id, args.reason))
        if args.mem_cmd == "history":
            sys.exit(agentbox_memory.memory_history(args.memory_id))
        if args.mem_cmd == "add":
            sys.exit(agentbox_memory.memory_add(args.statement, args.scope, args.memory_type,
                                args.supersedes))
        sys.exit(agentbox_memory.memory_decide(args.mem_cmd, args.proposal_id, getattr(args, "reason", "")))
    if args.cmd == "feedback":
        if args.fb_cmd == "list":
            sys.exit(agentbox_memory.feedback_list(args.status))
        sys.exit(agentbox_memory.feedback_decide(args.fb_cmd, args.feedback_id, args.note))


if __name__ == "__main__":
    main()
