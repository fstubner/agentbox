#!/usr/bin/env python3
"""Per-identity self-service, and the operations plane for the operator.

Two audiences, one process, one authorisation model:

- **Members** review the memories the assistant proposed about *them*, and
  connect or disconnect their own accounts. Sam should never need a terminal
  to say "no, don't remember that" or "use my other Google account".
- **Admins** additionally see connector health and set up the messaging apps
  the gateway talks through.

## Why this exists at all

Private memory proposals used to be approvable by nobody. The review token is
the only route to approval, the operator CLI is the only holder of it, and
having Alex approve Sam's *private* memories would defeat the point of them
being private. The queue was therefore unreachable by design once more than one
person existed. A self-service surface is not a convenience here; it is the
missing half of the review gate.

## Magic links

You type your email address, a link arrives, opening it signs you in. No
password to choose, forget, or reuse — which matters when the people using this
are a household rather than a company.

The link is single-use, expires in ten minutes, is stored only as a hash so
this directory leaking yields nothing usable, is compared in constant time, and
is rate-limited per address.

### Why the link is also bound to your browser

Ordinarily a magic link is a bearer token: whoever holds it is you. That is a
bad fit *here specifically*, because *the assistant can read the inbox the link
is sent to*. It has search_gmail and read_gmail on Alex's account. A
prompt-injected model could search for the message, follow the link, sign in as
Alex, and approve its own memory proposals — and the review gate is its only
route to durable memory, so self-approval collapses it entirely.

Blocking that by hiding the sender from the assistant's Gmail queries would be
an allowlist the assistant could reason its way around. Instead the link is
constrained: requesting one sets a nonce cookie, and redemption requires that
cookie. The link works in the browser that asked for it and nowhere else.

Whoever merely *reads* the link cannot use it. That holds for email, for
Discord, for a screenshot in a chat log — any channel, including ones added
later, rather than a defence aimed at one of them. Discord is just how you talk
to the assistant; it is not part of the trust path.

The assistant has exactly one route in: `POST /agent/link`, behind a token it
holds, which mints an ORIGIN_AGENT link that can read but not decide.
Everything else here is closed to it: it cannot list links, read a session, or
reach any other route on this port.

Be precise about where the identity binding lives, because it is not
here.
This endpoint takes an identity in the request body and will mint for any
name it recognises. What makes that safe is the caller: the MCP tool exposes no
identity parameter and passes the one its own bearer token resolved to. This
port trusts its token holder to have bound identity already.

That paragraph used to read "Nothing here is an MCP tool. The assistant cannot
mint a link" and stayed that way after the tool was added. A trust claim that
has quietly stopped being true is worse than none, because it is the thing
somebody checks instead of the code.

## Roles

Two, not an engine. `admin` and `member`, deny by default, resolved from
AGENTBOX_ADMINS. A general RBAC system would be a second policy vocabulary
sitting next to approval-policy.yaml, and two policy systems disagree about
who may do what — usually at the moment it matters.

Stdlib only, like everything else on this host.
"""
from __future__ import annotations

import argparse
import importlib.util as _importlib_util
import json
import os
import sys
from http.server import ThreadingHTTPServer
from pathlib import Path


def _sibling(name: str):
    """Load a module that ships beside this script.

    The portal is deployed as a single executable rather than an installed
    package, so its modules are loaded by path. Keeping them as real files
    rather than inlining everything is what stops this script becoming the
    only place any of it can be understood.
    """
    if name in sys.modules:
        return sys.modules[name]
    spec = _importlib_util.spec_from_file_location(
        name, Path(__file__).resolve().parent / f"{name}.py")
    module = _importlib_util.module_from_spec(spec)
    # Registered before execution, not after: @dataclass resolves
    # sys.modules[cls.__module__] while the class body runs, and gets None if
    # the module is not there yet. Loading a module by path without this works
    # right up until the module contains a dataclass.
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module

agentbox_settings = _sibling("agentbox_settings")
agentbox_household = _sibling("agentbox_household")
agentbox_status = _sibling("agentbox_status")
agentbox_onboarding = _sibling("agentbox_onboarding")


def _part(name: str):
    """Load one of the portal's own modules, fresh, as `<this module>.<name>`.

    Fresh rather than cached because each module reads its settings from the
    environment when it runs, the same as this file always has, and a portal
    loaded twice (as the tests do) must not share the first one's settings.
    Every name a part exports is also defined here, so the views and any caller
    see one namespace.
    """
    spec = _importlib_util.spec_from_file_location(
        f"{__name__}.{name}", Path(__file__).resolve().parent / f"agentbox_portal_{name}.py")
    module = _importlib_util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    globals().update({n: getattr(module, n) for n in module.__all__})
    return module


# Order matters: each part may use what the earlier ones export, and the
# handler's base classes must exist before the server part defines it.
config = _part("config")
messages = _part("messages")
auth = _part("auth")
memory = _part("memory")
accounts = _part("accounts")
