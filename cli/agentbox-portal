# --- commands ------------------------------------------------------------------

def cmd_link(args) -> int:
    """Mint a login link and print it.

    Printing rather than sending, for now: delivery needs the portal's own
    Discord application (see the module docstring), and until that token exists
    a link handed over by the operator is honest about who is delivering it.
    """
    try:
        url, link_id = auth.mint_link(args.identity, args.base_url,
                                 origin=getattr(args, "origin", config.ORIGIN_OPERATOR))
    except RuntimeError as exc:
        print(f"[fail] {exc}", file=sys.stderr)
        return 1
    minutes = config.LINK_TTL_SECONDS // 60
    print(url)
    print(f"\n[ok] link {link_id} for {args.identity} — single use, "
          f"expires in {minutes} minutes", file=sys.stderr)
    return 0

def reap_expired() -> tuple[int, int]:
    """Delete session and link records that can no longer authenticate anyone.

    Nothing removed these, so they accumulated: 34 sessions and 5 link records
    were still on disk days after every one of them had expired. None of it is
    exploitable — redemption checks `expires_at` and `used_at` regardless — but
    each file holds an identity and a secret hash, and keeping a credential
    record past the point where it can authorise anything is a disclosure
    surface with no remaining purpose.

    Runs at startup rather than on a timer: the portal restarts often enough,
    and a reaper that needs its own scheduler is a second thing to keep alive.
    Failure here is not worth refusing to serve over — an unreadable record is
    skipped, not fatal.
    """
    sessions = links = 0
    for directory, counter in (("sessions", "s"), ("links", "l")):
        base = config.STATE / directory
        if not base.is_dir():
            continue
        for record_file in base.glob("*.json"):
            try:
                record = json.loads(record_file.read_text(encoding="utf-8"))
                expired = int(record.get("expires_at", 0)) <= config.now()
                # A used link is spent even if its clock has not run out.
                spent = bool(record.get("used_at"))
            except (OSError, ValueError, TypeError):
                continue
            if not (expired or spent):
                continue
            try:
                record_file.unlink()
            except OSError:
                continue
            if counter == "s":
                sessions += 1
            else:
                links += 1
    return sessions, links

def cmd_serve(args) -> int:
    config.STATE.mkdir(parents=True, exist_ok=True)
    # Mint the consent-state secret now, not on the first reconnect click. If
    # this directory is unwritable the process should fail here at startup,
    # where systemd shows it — not as a 500 halfway through someone's OAuth
    # flow days later.
    auth.state_secret()
    dead_sessions, dead_links = reap_expired()
    if dead_sessions or dead_links:
        print(f"[ok] reaped {dead_sessions} expired session(s) and "
              f"{dead_links} spent link(s)", file=sys.stderr)
    # Onboarding owns its own directories, so it reaps them. Same moment, same
    # reasoning: an invite that expired unused still holds the secret that
    # made its link a credential.
    dead_settled, dead_invites = agentbox_onboarding.reap()
    if dead_settled or dead_invites:
        print(f"[ok] reaped {dead_settled} settled onboarding record(s) and "
              f"{dead_invites} expired invite(s)", file=sys.stderr)
    httpd = ThreadingHTTPServer((args.host, args.port), server.PortalHandler)
    print(f"[ok] portal on http://{args.host}:{args.port}", file=sys.stderr)
    # Said loudly at startup because it cannot be said at the point of failure.
    # The sign-in page answers identically whether or not delivery worked —
    # anything else would reveal which addresses are registered — so an
    # unconfigured SMTP host produces a link nobody receives and a page that
    # looks like it worked. This is the only place a human finds out.
    if config.SETTINGS.value("identity_emails") and not config.SETTINGS.value("smtp_host"):
        print("[warn] sign-in addresses are configured but no mail server is: "
              "links will be minted and never sent, and the page cannot say so "
              "because answering differently for a registered address would "
              "reveal who lives here. Set one under Operations, connect "
              "Discord on the Accounts page, or hand links over with "
              "`agentbox-portal link <name>`.", file=sys.stderr)
    print(f"[..] admins: {', '.join(sorted(auth.admin_names())) or 'none'}",
          file=sys.stderr)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0

def main() -> int:
    parser = argparse.ArgumentParser(description="Agentbox self-service portal")
    sub = parser.add_subparsers(dest="cmd", required=True)

    link = sub.add_parser("link", help="mint a single-use login link")
    link.add_argument("identity")
    link.add_argument("--base-url", default=os.environ.get(
        "AGENTBOX_PORTAL_URL", "http://agentbox.local:8771"))
    link.add_argument("--origin", choices=(config.ORIGIN_OPERATOR, config.ORIGIN_CHAT),
                      default=config.ORIGIN_OPERATOR,
                      help="operator: handed over directly, full privilege. "
                           "chat: delivered over a channel the assistant can "
                           "read, so it can look but not act.")
    link.set_defaults(func=cmd_link)

    serve = sub.add_parser("serve", help="run the portal")
    serve.add_argument("--host", default=os.environ.get("AGENTBOX_BIND_HOST", "127.0.0.1"))
    serve.add_argument("--port", type=int, default=8771)
    serve.set_defaults(func=cmd_serve)

    args = parser.parse_args()
    return args.func(args)

if __name__ == "__main__":
    sys.exit(main())
