def render_signin(sent: bool = False) -> bytes:
    """The signed-out page. It never echoes text from the URL.

    It used to render whatever `?m=` carried, which is how a redirect meant
    for a signed-in page — "Google consent received. An operator has to finish
    it…" — ended up greeting anyone who opened a stale URL, truncated at 120
    characters, long after the thing it described had been finished. Worse, it
    told an unauthenticated visitor what the box had recently been doing.
    Only one message belongs here, and it is fixed text.
    """
    told = ("If that address belongs to someone here, a sign-in link is on "
            "its way. It will only work in this browser.")
    return page("Sign in \u2014 Agentbox", SIGNIN.format(
        minutes=LINK_TTL_SECONDS // 60,
        flash=f"<div class=flash>{told}</div>" if sent else ""))


