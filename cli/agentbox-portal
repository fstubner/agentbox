def render_signin(flash: str = "") -> bytes:
    return page("Sign in \u2014 Agentbox", SIGNIN.format(
        minutes=LINK_TTL_SECONDS // 60,
        flash=f"<div class=flash>{html.escape(flash)}</div>" if flash else ""))


def render_admin(identity: str, flash: str) -> bytes:
    parts = ["<h1>Operations</h1>",
             "<p class=sub>Admin only. Connector health and messaging setup.</p>"]
    if flash:
        parts.append(f"<div class=flash>{html.escape(flash)}</div>")
    parts.append("<nav><a href='/'>&larr; Your memories</a></nav><p></p>")
    parts.append(
        "<div class=card><b>Connector health</b>"
        "<p class=sub style='margin:.4rem 0 0'>Revoking access at Google leaves "
        "this box holding a dead refresh token; without a check the first "
        "symptom is a confusing tool failure days later.</p></div>")
    parts.append("<footer><a href='/logout'>Sign out</a></footer>")
    return page("Operations — Agentbox", "".join(parts))


# --- server --------------------------------------------------------------------


def cookie_value(header: str, name: str) -> str:
    for part in header.split(";"):
        key, _, value = part.strip().partition("=")
        if key == name:
            return value
    return ""


class PortalHandler(BaseHTTPRequestHandler):
    server_version = "agentbox-portal"

    def log_message(self, fmt, *args):  # noqa: A002
        sys.stderr.write(f"[portal] {fmt % args}\n")

    def _send(self, code: int, body: bytes, headers: dict | None = None) -> None:
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        # This page shows private memories and can revoke credentials. It has
        # no business being framed, sniffed, or leaked through a referrer.
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Cache-Control", "no-store")
        for key, value in (headers or {}).items():
            self.send_header(key, value)
        self.end_headers()
        self.wfile.write(body)

    def _session(self) -> dict | None:
        return load_session(cookie_value(self.headers.get("Cookie", ""), "sid"))

    def _redirect(self, location: str, headers: dict | None = None) -> None:
        self.send_response(303)
        self.send_header("Location", location)
        for key, value in (headers or {}).items():
            self.send_header(key, value)
        self.end_headers()

    def do_GET(self) -> None:  # noqa: N802
        parsed = urllib.parse.urlparse(self.path)
        query = urllib.parse.parse_qs(parsed.query)
        flash = (query.get("m") or [""])[0][:120]

        if parsed.path == "/login":
            identity, reason = redeem_link(
                (query.get("id") or [""])[0], (query.get("k") or [""])[0],
                cookie_value(self.headers.get("Cookie", ""), "req"))
            if not identity:
                self._send(403, page("Not valid", f"<h1>Sorry</h1>"
                                     f"<p>{html.escape(reason)}</p>"))
                return
            sid = new_session(identity)
            # The request nonce has done its job; leaving it set would let a
            # later link be spent from this browser without a fresh request.
            # HttpOnly so a script cannot read it; SameSite=Lax so another site
            # cannot drive a POST here with the user's cookie attached.
            self.send_response(303)
            self.send_header("Location", "/")
            self.send_header("Set-Cookie",
                             f"sid={sid}; HttpOnly; SameSite=Lax; Path=/")
            self.send_header("Set-Cookie",
                             "req=; Max-Age=0; HttpOnly; SameSite=Lax; Path=/")
            self.end_headers()
            return

        session = self._session()
        if not session:
            self._send(401, render_signin(flash))
            return

        if parsed.path == "/logout":
            end_session(cookie_value(self.headers.get("Cookie", ""), "sid"))
            self._redirect("/", {"Set-Cookie":
                                 "sid=; Max-Age=0; HttpOnly; SameSite=Lax; Path=/"})
            return

        if parsed.path == "/admin":
            if not can(session["role"], "ops:read_health"):
                self._send(403, page("Not allowed",
                                     "<h1>Not allowed</h1><p>Operations is "
                                     "admin only.</p>"))
                return
            self._send(200, render_admin(session["identity"], flash))
            return

        if parsed.path == "/":
            self._send(200, render_home(session["identity"], session["role"],
                                        flash))
            return
        self._send(404, page("Not found", "<h1>Not found</h1>"))

    def _request_link(self, address: str) -> None:
        """Handle a sign-in request.

        The answer is identical whether or not the address is registered, and
        whether or not delivery succeeded. Anything else turns this form into a
        way to enumerate who lives here.
        """
        told = ("If that address belongs to someone here, a sign-in link is on "
                "its way. It will only work in this browser.")
        identity = identity_for_email(address)
        nonce = secrets.token_urlsafe(24)
        if identity:
            try:
                url, _ = mint_link(identity, PUBLIC_URL, request_nonce=nonce)
                sent, detail = send_link_email(address, url)
                if not sent:
                    # Visible to the operator, never to the browser.
                    sys.stderr.write(
                        f"[portal] link for {identity} not delivered: {detail}\n")
            except RuntimeError as exc:
                sys.stderr.write(f"[portal] {exc}\n")
        self.send_response(303)
        self.send_header("Location", "/?" + urllib.parse.urlencode({"m": told}))
        self.send_header("Set-Cookie",
                         f"req={nonce}; HttpOnly; SameSite=Lax; Path=/; "
                         f"Max-Age={LINK_TTL_SECONDS}")
        self.end_headers()

    def do_POST(self) -> None:  # noqa: N802
        length = int(self.headers.get("Content-Length") or 0)
        form = urllib.parse.parse_qs(self.rfile.read(length).decode())
        path = urllib.parse.urlparse(self.path).path

        if path == "/request":
            self._request_link((form.get("email") or [""])[0])
            return

        session = self._session()
        if not session:
            self._send(401, render_signin())
            return

        if path == "/memory/decide":
            try:
                _, message = decide_memory(
                    session["identity"], session["role"],
                    (form.get("id") or [""])[0],
                    (form.get("verb") or [""])[0] == "approve")
            except PermissionError:
                message = "Not allowed."
            self._redirect("/?" + urllib.parse.urlencode({"m": message}))
            return
        self._send(404, page("Not found", "<h1>Not found</h1>"))


# --- commands ------------------------------------------------------------------


def cmd_link(args) -> int:
    """Mint a login link and print it.

    Printing rather than sending, for now: delivery needs the portal's own
    Discord application (see the module docstring), and until that token exists
    a link handed over by the operator is honest about who is delivering it.
    """
    try:
        url, link_id = mint_link(args.identity, args.base_url)
    except RuntimeError as exc:
        print(f"[fail] {exc}", file=sys.stderr)
        return 1
    minutes = LINK_TTL_SECONDS // 60
    print(url)
    print(f"\n[ok] link {link_id} for {args.identity} — single use, "
          f"expires in {minutes} minutes", file=sys.stderr)
    return 0


def cmd_serve(args) -> int:
    STATE.mkdir(parents=True, exist_ok=True)
    server = ThreadingHTTPServer((args.host, args.port), PortalHandler)
    print(f"[ok] portal on http://{args.host}:{args.port}", file=sys.stderr)
    print(f"[..] admins: {', '.join(sorted(admin_names())) or 'none'}",
          file=sys.stderr)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Agentbox self-service portal")
    sub = parser.add_subparsers(dest="cmd", required=True)

    link = sub.add_parser("link", help="mint a single-use login link")
    link.add_argument("identity")
    link.add_argument("--base-url", default=os.environ.get(
        "AGENTBOX_PORTAL_URL", "http://agentbox.local:8771"))
    link.set_defaults(func=cmd_link)

    serve = sub.add_parser("serve", help="run the portal")
    serve.add_argument("--host", default="0.0.0.0")
    serve.add_argument("--port", type=int, default=8771)
    serve.set_defaults(func=cmd_serve)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
