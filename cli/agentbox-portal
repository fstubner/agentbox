#!/usr/bin/env python3
"""The self-service portal for household members, and Operations for admins.

- **Members** review the memories the assistant proposed about them, and
  connect or disconnect their own accounts, without a terminal.
- **Admins** also see service health and settings, and invite people.

Private memory proposals need someone other than the operator to approve
them, because the operator approving another person's private memories would
defeat the point. This page is how each person reaches their own.

## Sign-in links

You enter your email address, a link arrives, and opening it signs you in.
There is no password. A link works once, expires after ten minutes, is stored
only as a hash, is compared in constant time, and is rate-limited per address.

A link is also bound to the browser that asked for it. The assistant can read
the inbox the link is sent to, so a link that worked anywhere would let an
injected instruction sign in and approve the assistant's own proposals.
Requesting a link sets a nonce cookie, and using the link needs that cookie.
Reading a link, in any channel, is not enough to use it.

The assistant has one route in, `POST /agent/link`, behind its own token. It
mints a link that can read but not decide. That endpoint accepts an identity in
the request body, so the identity binding lives in the caller, not here. The
MCP tool has no identity parameter and passes the one its own bearer token
resolved to.

## Roles

Two roles, `admin` and `member`, deny by default, taken from AGENTBOX_ADMINS.
A general role system would be a second policy vocabulary next to
approval-policy.yaml, and two policy systems can disagree.

## Layout

This file holds the commands and wiring. The rest is in sibling modules,
loaded in order by `_part`: config, messages, auth, memory, accounts,
delivery, and the request handler in server, actions and signin. Rendering is
in the agentbox_portal_views, cards, admin, engine and calendar modules.
"""
from __future__ import annotations

import argparse
import importlib.util as _importlib_util
import json
import os
import sys
from http.server import ThreadingHTTPServer
from pathlib import Path


def _sibling(name: str):
    """Load a module that ships beside this script.

    The portal is deployed as a single executable rather than an installed
    package, so its modules are loaded by path. Keeping them as real files
    rather than inlining everything is what stops this script becoming the
    only place any of it can be understood.
    """
    if name in sys.modules:
        return sys.modules[name]
    spec = _importlib_util.spec_from_file_location(
        name, Path(__file__).resolve().parent / f"{name}.py")
    module = _importlib_util.module_from_spec(spec)
    # Registered before running, because @dataclass looks the module up in
    # sys.modules while the class body runs.
    sys.modules[name] = module
    spec.loader.exec_module(module)
    return module

agentbox_settings = _sibling("agentbox_settings")
agentbox_household = _sibling("agentbox_household")
agentbox_status = _sibling("agentbox_status")
agentbox_onboarding = _sibling("agentbox_onboarding")


def _part(name: str):
    """Load one of the portal's own modules, fresh, as `<this module>.<name>`.

    Fresh rather than cached because each module reads its settings from the
    environment when it runs, the same as this file always has, and a portal
    loaded twice (as the tests do) must not share the first one's settings.
    Every name a part exports is also defined here, so the views and any caller
    see one namespace.
    """
    spec = _importlib_util.spec_from_file_location(
        f"{__name__}.{name}", Path(__file__).resolve().parent / f"agentbox_portal_{name}.py")
    module = _importlib_util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    globals().update({n: getattr(module, n) for n in module.__all__})
    return module


# Order matters: each part may use what the earlier ones export, and the
# handler's base classes must exist before the server part defines it.
config = _part("config")
messages = _part("messages")
auth = _part("auth")
memory = _part("memory")
accounts = _part("accounts")
delivery = _part("delivery")
actions = _part("actions")
signin = _part("signin")
server = _part("server")

# --- pages & views -------------------------------------------------------------
agentbox_portal_style = _sibling("agentbox_portal_style")
agentbox_portal_engine = _sibling("agentbox_portal_engine")
agentbox_portal_views = _sibling("agentbox_portal_views")
agentbox_portal_cards = _sibling("agentbox_portal_cards")
agentbox_portal_admin = _sibling("agentbox_portal_admin")
agentbox_portal_calendar = _sibling("agentbox_portal_calendar")

agentbox_portal_engine.bind(sys.modules[__name__])
agentbox_portal_calendar.bind(sys.modules[__name__])
agentbox_portal_views.bind(sys.modules[__name__])
agentbox_portal_cards.bind(sys.modules[__name__])
agentbox_portal_admin.bind(sys.modules[__name__])

page = agentbox_portal_views.page
chrome = agentbox_portal_views.chrome
STYLE = agentbox_portal_views.STYLE
time_ago = agentbox_portal_views.time_ago
render_overview = agentbox_portal_views.render_overview
render_home = agentbox_portal_views.render_home
SIGNIN = agentbox_portal_views.SIGNIN
render_signin = agentbox_portal_views.render_signin
render_connectors = agentbox_portal_views.render_connectors
render_knowledge = agentbox_portal_views.render_knowledge

render_status_card = agentbox_portal_cards.render_status_card
render_onboarding_card = agentbox_portal_cards.render_onboarding_card
render_proposals_card = agentbox_portal_cards.render_proposals_card
render_new_invite_card = agentbox_portal_cards.render_new_invite_card

render_people_card = agentbox_portal_admin.render_people_card
form_field = agentbox_portal_admin.form_field
render_settings_card = agentbox_portal_admin.render_settings_card
render_household_card = agentbox_portal_admin.render_household_card
render_admin = agentbox_portal_admin.render_admin

# --- commands ------------------------------------------------------------------

def cmd_link(args) -> int:
    """Mint a login link and print it.

    Printing rather than sending, for now: delivery needs the portal's own
    Discord application (see the module docstring), and until that token exists
    a link handed over by the operator is honest about who is delivering it.
    """
    try:
        url, link_id = auth.mint_link(args.identity, args.base_url,
                                 origin=getattr(args, "origin", config.ORIGIN_OPERATOR))
    except RuntimeError as exc:
        print(f"[fail] {exc}", file=sys.stderr)
        return 1
    minutes = config.LINK_TTL_SECONDS // 60
    print(url)
    print(f"\n[ok] link {link_id} for {args.identity}, single use, "
          f"expires in {minutes} minutes", file=sys.stderr)
    return 0

def reap_expired() -> tuple[int, int]:
    """Delete session and link records that can no longer authenticate anyone.

    They cannot be used once expired, but each holds an identity and a secret
    hash, so there is no reason to keep them. Runs at startup rather than on a
    timer, and skips any record it cannot read.
    """
    sessions = links = 0
    for directory, counter in (("sessions", "s"), ("links", "l")):
        base = config.STATE / directory
        if not base.is_dir():
            continue
        for record_file in base.glob("*.json"):
            try:
                record = json.loads(record_file.read_text(encoding="utf-8"))
                expired = int(record.get("expires_at", 0)) <= config.now()
                # A used link is spent even if its clock has not run out.
                spent = bool(record.get("used_at"))
            except (OSError, ValueError, TypeError):
                continue
            if not (expired or spent):
                continue
            try:
                record_file.unlink()
            except OSError:
                continue
            if counter == "s":
                sessions += 1
            else:
                links += 1
    return sessions, links

def cmd_serve(args) -> int:
    config.STATE.mkdir(parents=True, exist_ok=True)
    # Create the consent-state secret now rather than on the first reconnect,
    # so an unwritable directory fails at startup where systemd shows it.
    auth.state_secret()
    dead_sessions, dead_links = reap_expired()
    if dead_sessions or dead_links:
        print(f"[ok] reaped {dead_sessions} expired session(s) and "
              f"{dead_links} spent link(s)", file=sys.stderr)
    # Onboarding owns its own directories, so it reaps them. Same moment, same
    # reasoning: an invite that expired unused still holds the secret that
    # made its link a credential.
    dead_settled, dead_invites = agentbox_onboarding.reap()
    if dead_settled or dead_invites:
        print(f"[ok] reaped {dead_settled} settled onboarding record(s) and "
              f"{dead_invites} expired invite(s)", file=sys.stderr)
    httpd = ThreadingHTTPServer((args.host, args.port), server.PortalHandler)
    print(f"[ok] portal on http://{args.host}:{args.port}", file=sys.stderr)
    # Said at startup because it cannot be said when it matters. The sign-in
    # page answers the same way whether or not delivery worked, so without a
    # mail server links are made, nobody receives them, and the page looks
    # fine. This is the only place a person finds out.
    if config.SETTINGS.value("identity_emails") and not config.SETTINGS.value("smtp_host"):
        print("[warn] sign-in addresses are configured but no mail server is: "
              "links will be minted and never sent, and the page cannot say so "
              "because answering differently for a registered address would "
              "reveal who lives here. Set one under Operations, connect "
              "Discord on the Accounts page, or hand links over with "
              "`agentbox-portal link <name>`.", file=sys.stderr)
    print(f"[..] admins: {', '.join(sorted(auth.admin_names())) or 'none'}",
          file=sys.stderr)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0

def main() -> int:
    parser = argparse.ArgumentParser(description="Agentbox self-service portal")
    sub = parser.add_subparsers(dest="cmd", required=True)

    link = sub.add_parser("link", help="mint a single-use login link")
    link.add_argument("identity")
    link.add_argument("--base-url", default=os.environ.get(
        "AGENTBOX_PORTAL_URL", "http://agentbox.local:8771"))
    link.add_argument("--origin", choices=(config.ORIGIN_OPERATOR, config.ORIGIN_CHAT),
                      default=config.ORIGIN_OPERATOR,
                      help="operator: handed over directly, full privilege. "
                           "chat: delivered over a channel the assistant can "
                           "read, so it can look but not act.")
    link.set_defaults(func=cmd_link)

    serve = sub.add_parser("serve", help="run the portal")
    serve.add_argument("--host", default=os.environ.get("AGENTBOX_BIND_HOST", "127.0.0.1"))
    serve.add_argument("--port", type=int, default=8771)
    serve.set_defaults(func=cmd_serve)

    args = parser.parse_args()
    return args.func(args)

if __name__ == "__main__":
    sys.exit(main())
