#!/usr/bin/env python3
"""Onboarding for someone who has never used a terminal.

An admin runs `agentbox invite create sam` and sends the link, and the person
fills in a short form on their phone. They never see Vikunja's login page, a
terminal or the Google Cloud console.

## Why this process has no privileges

One service that took the answers, created the Vikunja account and set up the
Google bridge would need the Docker socket. A web page on the LAN must not hold
the Docker socket. `docker inspect` reads every bridge credential, and
`docker run -v /:/host` is a root shell.

So this process only collects answers. It has no Docker socket, no secret
manager token and no bridge tokens, cannot create an identity, and writes one
spool file. The privileged half runs separately. That split is necessary,
because Vikunja registration is off and creating an account needs
`vikunja user create` inside the container.

## The invite token is a credential

It authorises creating an identity on someone's home server, so it is single
use, expires, and is compared in constant time.
"""
from __future__ import annotations

import argparse
import hmac
import html
import json
import os
import sys
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

# The rest of the invite lives in sibling modules beside this script.
sys.path.insert(0, str(Path(__file__).resolve().parent))
from agentbox_invite_page import (  # noqa: E402, F401
    DONE,
    FORM,
    GOOGLE_DONE,
    GOOGLE_STEP,
    PAGE,
    render_form,
)
from agentbox_invite_records import (  # noqa: E402, F401
    CONNECTORS,
    DEFAULT_TTL_HOURS,
    GOOGLE_CLIENT_ID,
    GOOGLE_SCOPES,
    PUBLIC_ORIGIN,
    STATE,
    google_auth_url,
    invite_path,
    load_invite,
    now,
    save_invite,
    valid_invite,
)

# Broad Drive read is opt-in, using the same flag as oauth-setup.py, so every
# way of granting a credential has the same default.
if os.environ.get("GOOGLE_ENABLE_DRIVE_READ_ALL", "").strip().lower() in (
        "1", "true", "yes"):
    GOOGLE_SCOPES += " https://www.googleapis.com/auth/drive.readonly"
BIND_HOST = os.environ.get("AGENTBOX_BIND_HOST", "127.0.0.1")
BIND_PORT = int(os.environ.get("AGENTBOX_INVITE_PORT", "8770"))


class InviteHandler(BaseHTTPRequestHandler):
    household = "the household"
    owner = "The owner"

    def log_message(self, fmt, *args):  # noqa: A003 (quieter default logging)
        # Never log the query string: the invite secret is in it.
        sys.stderr.write(f"[invite] {self.command} "
                         f"{urllib.parse.urlparse(self.path).path}\n")

    def _send(self, status: int, body: str) -> None:
        data = body.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        # This page is only ever opened directly from a link.
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)

    def _error(self, message: str) -> None:
        self._send(400, PAGE.format(household=html.escape(self.household),
                                    body=f'<p class="err">{html.escape(message)}</p>'))

    def _credentials(self) -> tuple[str, str]:
        query = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        return (query.get("i", [""])[0].strip(), query.get("t", [""])[0].strip())

    def _google_callback(self) -> None:
        """Google hands the authorisation code back here.

        The code is stored, not exchanged. Exchanging needs the client secret,
        which this process does not have. `agentbox invite complete` does the
        exchange and provisions their bridge.
        """
        query = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        state = query.get("state", [""])[0]
        token_id, _, secret = state.partition(":")
        # The invite is already marked used by this point, so validate against
        # the record directly, not through valid_invite.
        record = load_invite(token_id)
        if not record or not hmac.compare_digest(
                str(record.get("secret", "")), secret):
            return self._error("This link is not valid. Ask for a new one.")

        if query.get("error"):
            return self._error(
                "Google was not connected. You can ask for a new invite and "
                "try again. Everything else you chose is already saved.")

        code = query.get("code", [""])[0]
        if not code:
            return self._error("Google did not return an authorisation code.")

        record["google_code"] = code
        record["google_redirect_uri"] = f"{PUBLIC_ORIGIN}/google/callback"
        save_invite(record)
        self._send(200, PAGE.format(
            household=html.escape(self.household),
            body=GOOGLE_DONE.format(owner=html.escape(self.owner))))

    def do_HEAD(self) -> None:
        self.do_GET()

    def do_GET(self) -> None:
        if urllib.parse.urlparse(self.path).path == "/google/callback":
            return self._google_callback()
        if urllib.parse.urlparse(self.path).path != "/":
            return self._send(404, PAGE.format(
                household=html.escape(self.household),
                body='<p class="err">Not found.</p>'))
        token_id, secret = self._credentials()
        record, reason = valid_invite(token_id, secret)
        if not record:
            return self._error(reason)
        self._send(200, render_form(self.household))

    def do_POST(self) -> None:
        token_id, secret = self._credentials()
        record, reason = valid_invite(token_id, secret)
        if not record:
            return self._error(reason)

        length = int(self.headers.get("Content-Length", "0") or "0")
        if length > 8192:
            return self._error("That form was unexpectedly large.")
        form = urllib.parse.parse_qs(self.rfile.read(length).decode("utf-8"))

        display_name = (form.get("display_name", [""])[0] or "").strip()[:40]
        if not display_name:
            return self._error("Please tell us what to call you.")

        chosen = [c for c in form.get("connector", [])
                  if c in CONNECTORS and CONNECTORS[c]["personal"]]

        # Claimed before anything else is written, so a double submit cannot
        # produce two identities from one invite.
        record["used_at"] = now()
        record["display_name"] = display_name
        record["connectors"] = chosen
        save_invite(record)

        # If they asked for Google, consent happens now, because a code is only
        # valid for minutes.
        if "google" in chosen and GOOGLE_CLIENT_ID and PUBLIC_ORIGIN:
            return self._send(200, PAGE.format(
                household=html.escape(self.household),
                body=GOOGLE_STEP.format(
                    name=f", {html.escape(display_name)}",
                    owner=html.escape(self.owner),
                    url=html.escape(google_auth_url(token_id, secret)))))

        self._send(200, PAGE.format(
            household=html.escape(self.household),
            body=DONE.format(name=f", {html.escape(display_name)}",
                             owner=html.escape(self.owner))))


# --- operator commands -----------------------------------------------------------


def _shared():
    """cli/agentbox_onboarding.py, which owns the invite record format.

    Loaded, not duplicated. This record carries the secret that makes the
    link a credential, and the portal mints the same record when an admin
    approves a draft. Two copies of that format would drift apart without any
    error.
    """
    import importlib.util as _ilu
    spec = _ilu.spec_from_file_location(
        "agentbox_onboarding",
        Path(__file__).resolve().parent / "agentbox_onboarding.py")
    module = _ilu.module_from_spec(spec)
    sys.modules["agentbox_onboarding"] = module
    spec.loader.exec_module(module)
    return module


def configured_identities() -> set[str]:
    """Who the gateway already acts for.

    Passed to create_invite so it can refuse a name that is taken. Completing
    an invite for an existing identity re-provisions that identity's bridge
    with whoever answered the form, which hands them that account.
    """
    raw = os.environ.get("AGENTBOX_IDENTITY_NAMES", "")
    return {n.strip().lower() for n in raw.replace(" ", ",").split(",")
            if n.strip()}


def cmd_create(args) -> int:
    shared = _shared()
    try:
        record = shared.create_invite(
            args.name, configured_identities(), args.ttl_hours)
    except shared.NameTaken:
        print(f"'{args.name}' already lives here. Inviting somebody to a name "
              f"that is taken would hand them that account, not create one.")
        return 1
    except ValueError as exc:
        print(str(exc))
        return 1
    token_id = record["id"]
    secret = record["secret"]
    host = args.host or "agentbox.local"
    print(f"Invite for '{args.name}', valid {args.ttl_hours}h, single use.\n")
    print(f"  http://{host}:{BIND_PORT}/?i={token_id}&t={secret}\n")
    print("This link is a credential: anyone holding it can create an identity")
    print("on this box. Send it directly, not to a group chat.\n")
    print("Then run the page while they fill it in:")
    print("  cli/agentbox-invite serve")
    print("and afterwards:")
    print(f"  cli/agentbox invite complete {token_id}")
    return 0


def cmd_serve(args) -> int:
    """Serve the form.

    Run by hand, it refuses to start with no invite outstanding, which usually
    means `create` was forgotten.

    `--unattended` keeps it running. Invitations arrive by email or DM, and the
    person opening one has no terminal and nobody to ask, so the page has to be
    up whenever a link might be opened. Every route still needs a valid invite
    token, which is single use, expires and is compared in constant time, so
    with nothing outstanding every request is refused.
    """
    pending = [r for r in _all_invites() if not r.get("used_at")
               and now() <= int(r.get("expires_at", 0))]
    if not pending and not args.unattended:
        print("No outstanding invites. Create one first:\n"
              "  cli/agentbox-invite create <name>", file=sys.stderr)
        return 1
    InviteHandler.household = args.household
    InviteHandler.owner = args.owner
    if not PUBLIC_ORIGIN:
        print("note: AGENTBOX_INVITE_ORIGIN is unset, so the Google step is "
              "skipped.\n      Set it to the URL they will open "
              "(e.g. http://127.0.0.1:8770 \u2014 Google refuses .local)\n      and register "
              "<that>/google/callback as a redirect URI on the OAuth client.",
              file=sys.stderr)
    elif not GOOGLE_CLIENT_ID:
        print("note: AGENTBOX_GOOGLE_CLIENT_ID is unset, so the Google step is "
              "skipped.", file=sys.stderr)
    server = ThreadingHTTPServer((BIND_HOST, BIND_PORT), InviteHandler)
    print(f"Onboarding page on {BIND_HOST}:{BIND_PORT}, "
          f"{len(pending)} invite(s) outstanding.")
    print("This is reachable on your LAN so they can open it from a phone.")
    if not args.unattended:
        print("Stop it (Ctrl-C) once they are done; it should not run "
              "permanently.")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")
    return 0


def _all_invites() -> list[dict]:
    if not STATE.is_dir():
        return []
    out = []
    for path in sorted(STATE.glob("*.json")):
        try:
            out.append(json.loads(path.read_text(encoding="utf-8")))
        except (OSError, ValueError):
            continue
    return out


def cmd_list(args) -> int:
    invites = _all_invites()
    if not invites:
        print("no invites")
        return 0
    for record in invites:
        if record.get("used_at"):
            state = f"submitted, awaiting `agentbox invite complete {record['id']}`"
        elif now() > int(record.get("expires_at", 0)):
            state = "expired"
        else:
            hours = (int(record["expires_at"]) - now()) // 3600
            state = f"outstanding, {hours}h left"
        print(f"  {record['id']}  {record.get('identity', '?'):<12} {state}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="agentbox-invite",
        description="Onboard a person without giving them a terminal.")
    sub = parser.add_subparsers(dest="cmd", required=True)

    create = sub.add_parser("create", help="mint a single-use invite link")
    create.add_argument("name", help="identity name, e.g. sam")
    create.add_argument("--ttl-hours", type=int, default=DEFAULT_TTL_HOURS)
    create.add_argument("--host", default="",
                        help="hostname they will reach this box on "
                             "(default agentbox.local)")

    serve = sub.add_parser("serve", help="run the page while they fill it in")
    serve.add_argument("--household", default="the household")
    serve.add_argument("--owner", default="The owner")
    serve.add_argument(
        "--unattended", action="store_true",
        help="stay up with nothing outstanding, for running as a unit, "
             "an invitation delivered by email reaches somebody who cannot "
             "ask anyone to start this")

    sub.add_parser("list", help="what is outstanding or awaiting completion")

    args = parser.parse_args()
    return {"create": cmd_create, "serve": cmd_serve,
            "list": cmd_list}[args.cmd](args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
