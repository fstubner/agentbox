# Restarts the local model stack when nothing is intentionally holding it down.
#
# Install:
#   cp cli/agentbox-keepalive.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now agentbox-keepalive.timer
#
# To keep the stack down on purpose (maintenance, a hand-run benchmark):
#   touch ~/.local/state/agentbox/keepalive-disabled
#
# See cli/agentbox_keepalive.py for why this is used instead of
# Restart=always. Every one of these stops is intentional, and systemd does not
# restart a unit somebody stopped on purpose. This timer restarts the stack
# after the stop is over.

[Unit]
Description=Restore the Agentbox model stack if an evaluation left it down
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/oss/agentbox/cli/agentbox keepalive --quiet

NoNewPrivileges=true
PrivateTmp=true
