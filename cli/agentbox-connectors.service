# Finishes what the portal spooled: reconnects and disconnects.
#
# Runs as the OPERATOR's user instance. It holds what the portal does not:
# the Google client secret, write access to the env directory, and the docker
# socket. The two are separate processes so that the LAN-reachable page cannot
# run containers. Docker socket access is root access, because
# `docker run -v /:/host` is a root shell.
#
# The portal spools a request and this unit completes it. People can fix their
# own accounts without asking the operator, and the privilege stays here.

[Unit]
Description=Complete Agentbox connector requests
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/oss/agentbox/cli/agentbox connectors sync --quiet

NoNewPrivileges=true
PrivateTmp=true
