# How often to check that the model stack is up.
#
# Two minutes. This covers a killed evaluation that nobody notices, which can
# leave the stack down for hours, so the difference between one minute and
# five does not matter. Each run is one pgrep and one systemctl is-active.
#
# OnBootSec matters more than the interval. A reboot during a run is one of the
# cases this handles, and without it the units would stay stopped until
# somebody opened a terminal.

[Unit]
Description=Periodically restore the Agentbox model stack

[Timer]
OnBootSec=90
OnUnitActiveSec=2min
AccuracySec=15

[Install]
WantedBy=timers.target
