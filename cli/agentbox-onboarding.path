# Watches for an approval the portal wrote.
#
# A path unit instead of a timer because an approval is an event. Somebody
# tapped a button and is waiting. A two-minute poll would leave the page
# showing no progress for up to two minutes.
#
# PathExistsGlob, not DirectoryNotEmpty. `agentbox invite drain` moves each
# request into onboarding/settled/ instead of deleting it, so the directory is
# never empty once anything has been approved. DirectoryNotEmpty would stay
# true and re-trigger forever. The glob only matches requests at the top
# level, which are the ones still waiting to be handled.
#
# systemd re-arms this when the condition goes false, which happens when drain
# settles the last request. A drain that fails still settles the request, with
# the reason, so a bad record produces one journal line and not a loop.
#
# The condition is also evaluated when the unit starts, so approvals written
# while this was stopped are picked up at boot.

[Unit]
Description=Watch for onboarding approvals from the portal

[Path]
PathExistsGlob=%h/.local/state/agentbox/onboarding/*.json
Unit=agentbox-onboarding.service

[Install]
WantedBy=paths.target
