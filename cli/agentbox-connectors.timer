# Completes connector requests raised in the portal.
#
# Install:
#   cp cli/agentbox-connectors.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now agentbox-connectors.timer
#
# Thirty seconds because Google expires authorisation codes after about ten
# minutes. Any interval under a couple of minutes is safe. Each run lists one
# directory, which is almost always empty.

[Unit]
Description=Finish Agentbox connector requests

[Timer]
OnBootSec=60
OnUnitActiveSec=30
AccuracySec=5

[Install]
WantedBy=timers.target
