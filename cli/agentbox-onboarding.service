# The privileged half of onboarding, triggered by a file instead of a shell.
#
# Install:
#   cp cli/agentbox-onboarding.{service,path} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now agentbox-onboarding.path
#
# Why this is a separate unit and not a button in the portal:
#
# Completing an invite runs `docker compose up` for a new bridge. The portal is
# a LAN-reachable page handling untrusted requests, and cli/agentbox-invite
# explains why such a page must never hold the docker socket. The portal writes
# a request and this unit reads it. The portal gains no capability, and a bug
# in request handling cannot reach a container.
#
# This separation is incomplete. agentbox-portal.service runs as the operator,
# who is in the `docker` group, so that process can already reach the socket.
# Only the absence of a code path stops it. There is no privilege boundary.
# The follow-up is to take the portal out of the docker group. Until then the
# split separates the code but not the process privileges.
#
# No `op run` wrapper, unlike agentbox-portal.service: service_env_values()
# resolves op:// references itself, sourcing 1password.env from the env
# directory, so this needs to run as somebody who can read that file and
# nothing more.

[Unit]
Description=Complete the invites an admin approved from the portal

[Service]
Type=oneshot
ExecStart=%h/oss/agentbox/cli/agentbox invite drain

NoNewPrivileges=true
PrivateTmp=true
