# Copy to $AGENTBOX_ENV_DIR/<name>-bridge.env and fill in.
# For 1Password-resolved deploys, use op:// references and name the file
# <name>-bridge.op.env instead; `cli/agentbox deploy` resolves them.

# The token the assistant presents to this bridge (assistant -> bridge).
EXAMPLE_BRIDGE_TOKEN=change-me

# The upstream credential this bridge holds (bridge -> external service).
# The assistant never sees this.
EXAMPLE_UPSTREAM_TOKEN=change-me

# Optional: bind published port to a specific LAN IP instead of localhost.
# LAN_BIND_IP=127.0.0.1
