# AppArmor profile for the Home Assistant container.
#
# This is Docker's `docker-default` profile, copied verbatim, plus the D-Bus
# rules Bluetooth needs and nothing else.
#
# ## Why a custom profile instead of apparmor=unconfined
#
# Home Assistant already runs with host networking, a mounted system D-Bus
# socket, NET_ADMIN and NET_RAW. Each of those is needed. Together they make it
# the most privileged container on this box, and it is the one service meant
# to be reachable from the LAN. AppArmor is its last default confinement, so
# it stays on.
#
# `docker-default` has no dbus rule, and AppArmor denies what a profile does
# not permit, so every D-Bus call is refused at the handshake:
#
#   apparmor="DENIED" operation="dbus_method_call" member="Hello"
#
# `Hello` is the first message a client sends, so the symptom is an EOFError
# with no useful detail.
#
# This profile keeps every restriction docker-default imposes and adds the
# smallest set of D-Bus rules that lets BlueZ work. It allows Bluetooth and
# nothing else.
#
# ## Install
#
#   sudo cp services/apparmor/agentbox-homeassistant /etc/apparmor.d/
#   sudo apparmor_parser -r -W /etc/apparmor.d/agentbox-homeassistant
#
# The compose file names it via security_opt. `apparmor_parser -r` is
# idempotent and safe to re-run. The profile survives reboot because it lives
# in /etc/apparmor.d.

#include <tunables/global>

profile agentbox-homeassistant flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,

  # --- docker-default, unchanged --------------------------------------------
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=agentbox-homeassistant,

  # --- the only addition: D-Bus for BlueZ -----------------------------------
  #
  # Scoped to what a Bluetooth client does. There is no blanket `dbus,` rule.
  # The container may talk to the bus daemon itself and to org.bluez, and to
  # nothing else on the system bus. systemd, NetworkManager, logind and the
  # other services stay unreachable. That is the reason for this file instead
  # of unconfining.

  # Connect and register. Without these the handshake fails at Hello.
  dbus send
       bus=system
       path=/org/freedesktop/DBus
       interface=org.freedesktop.DBus
       member={Hello,AddMatch,RemoveMatch,GetNameOwner,NameHasOwner,ListNames,ListActivatableNames,StartServiceByName,ReleaseName,RequestName},

  # Bus housekeeping signals (name ownership changes, disconnects).
  dbus receive
       bus=system
       path=/org/freedesktop/DBus
       interface=org.freedesktop.DBus,

  # Talk to BlueZ: adapters, devices, GATT, advertising.
  dbus (send,receive)
       bus=system
       peer=(name=org.bluez),

  # BlueZ pushes device discovery over ObjectManager and Properties signals,
  # which arrive from the bus rather than from a named peer.
  dbus receive
       bus=system
       path=/org/bluez/**,

  # Device discovery. BlueZ announces a device appearing or disappearing with
  # InterfacesAdded / InterfacesRemoved on the ObjectManager. It sends these at
  # the ROOT path `/`, not under /org/bluez, and from its unique connection
  # name (:1.3), not the well-known org.bluez. Neither rule above matches, so
  # without this rule every announcement is denied.
  #
  # Those denials are silent. Home Assistant reports no error, and Bluetooth
  # devices such as SwitchBot sensors never appear. The only trace is in the
  # kernel audit log, and nothing in this platform reads it.
  #
  # Scoped to the one interface that carries the announcement, so this does not
  # become a general permission to receive signals from anything on the bus.
  dbus receive
       bus=system
       path=/
       interface=org.freedesktop.DBus.ObjectManager,

  # Peer-scoped, not interface-scoped. An unscoped rule on these three
  # interfaces permits introspecting *any* service on the bus, including
  # systemd1 and login1. Every rule on a standard interface must name its peer.
  #
  # The parser requires peer= to come last. If the order is wrong,
  # apparmor_parser rejects the file and leaves the *previous* profile loaded.
  # The container keeps running with the old profile, and the edit looks
  # applied when it is not.
  dbus (send,receive)
       bus=system
       interface=org.freedesktop.DBus.{Properties,ObjectManager,Introspectable}
       peer=(name=org.bluez),

  # Agents and profiles BlueZ calls back into live under the client's own
  # object tree, so it must be able to receive those calls.
  dbus (send,receive)
       bus=system
       interface=org.bluez.{Agent1,Profile1,GattService1,GattCharacteristic1,GattDescriptor1,LEAdvertisement1}
       peer=(name=org.bluez),
}
