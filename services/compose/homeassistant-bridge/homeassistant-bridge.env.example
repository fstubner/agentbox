# host.docker.internal, not 127.0.0.1: Home Assistant runs with host
# networking, and inside this container that loopback is the container.
HA_URL=http://host.docker.internal:8123
HA_TOKEN=
HA_BRIDGE_TOKEN=

# Entities the assistant may control. Empty = read the house, change nothing.
HA_CONTROLLABLE_ENTITIES=

# Cameras it may look at, one at a time. Empty = it can never look.
# Prefer presence sensors for "which room is someone in" — those are ordinary
# reads and need nothing here.
HA_VIEWABLE_CAMERAS=

# Screens cleared for full detail. Everything else is treated as shared and
# receives only the summary, like a phone lock screen.
HA_PRIVATE_SCREENS=
