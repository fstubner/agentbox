[Unit]
Description=Agentbox VibeThinker local reasoning worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/llama.cpp/build-vulkan/bin/llama-server --hf-repo allanrurangira/VibeThinker-3B-Q4_K_M-GGUF --hf-file vibethinker-3b-q4_k_m.gguf --alias vibethinker-worker -c 32768 --host 127.0.0.1 --port 1236 -ngl 999 --flash-attn on --jinja
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
